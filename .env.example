# ── Contact form ─────────────────────────────────────────────
# Option A (recommended for production): Resend email delivery
RESEND_API_KEY=
CONTACT_EMAIL=nallamothusrinath999@gmail.com
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Option B: Supabase table storage
# Create a `messages` table with: name, email, subject, message, created_at
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Without either provider, messages are appended to .data/messages.jsonl
# for local use. The API still validates and accepts submissions.

# ── GitHub integration ───────────────────────────────────────
# Optional. Raises the API rate limit from 60 to 5,000 req/hour.
GITHUB_TOKEN=

# ── Site ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://srinath.dev
